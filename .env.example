# Copy to .env (git-ignored) and fill in only what you want to use. Every integration is OFF unless its flag is 1.
# Never commit .env, never paste these values into chat, issues or documentation.

# --- core pipeline (optional) ---
SOCRATA_APP_TOKEN=

# --- Gemini evidence assistant (ai.google.dev; key created in Google AI Studio) ---
ROADWATCH_ENABLE_GEMINI=0
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# ROADWATCH_ASSISTANT_MAX_REQUESTS=20

# --- ElevenLabs audio narration ---
ROADWATCH_ENABLE_ELEVENLABS=0
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Tiger Data (PostgreSQL/TimescaleDB); URL must include sslmode=require for Tiger Cloud ---
ROADWATCH_ENABLE_TIGER=0
TIGER_DATABASE_URL=

# --- Snowflake evidence briefs (use a READ-ONLY role and a programmatic access token) ---
ROADWATCH_ENABLE_SNOWFLAKE=0
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_CORTEX_MODEL=claude-sonnet-4-5
# ROADWATCH_SNOWFLAKE_MAX_REQUESTS=10

# --- Solana DEVNET receipts: path to a Solana CLI keypair JSON file kept OUTSIDE this repository ---
ROADWATCH_ENABLE_SOLANA=0
SOLANA_KEYPAIR_PATH=
# SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Presage Human Factors Lab: not implemented (no Python SDK); flag has no effect ---
ROADWATCH_ENABLE_PRESAGE=0
